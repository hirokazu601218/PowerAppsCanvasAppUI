{
  "source": "2026-09-28 添付4定義書（列名、型、制約。個人実データなし）",
  "tables": [
    {
      "key": "work",
      "display_name": "T_給与勤務条件",
      "schema_name": "crb3c_WorkCondition",
      "logical_name": "crb3c_workcondition",
      "studio_schema_name": "crb3c_StudioWorkCondition",
      "studio_logical_name": "crb3c_studioworkcondition",
      "columns": [
        {
          "display_name": "職員番号",
          "logical_name": "crb3c_staffnumber",
          "kind": "text",
          "source_constraint": "12桁の数字文字列。先頭0埋め。正規表現: ^[0-9]{12}$",
          "source_required": "任意",
          "max_length": 200
        },
        {
          "display_name": "氏名",
          "logical_name": "crb3c_fullname",
          "kind": "text",
          "source_constraint": "全角氏名を想定。姓と名の間は全角空白",
          "source_required": "任意",
          "max_length": 200
        },
        {
          "display_name": "適用開始日",
          "logical_name": "crb3c_startdate",
          "kind": "date",
          "source_constraint": "YYYY/MM/DD形式。有効な暦日",
          "source_required": "任意"
        },
        {
          "display_name": "適用終了日",
          "logical_name": "crb3c_enddate",
          "kind": "date",
          "source_constraint": "YYYY/MM/DD形式。有効な暦日",
          "source_required": "任意"
        },
        {
          "display_name": "異動区分",
          "logical_name": "crb3c_transferkind",
          "kind": "text",
          "source_constraint": "設定値: #N/A、0、非常勤休職、非常勤変更、非常勤採用、非常勤退職",
          "source_required": "任意",
          "max_length": 200
        },
        {
          "display_name": "発令事由区分",
          "logical_name": "crb3c_appointmentreason",
          "kind": "text",
          "source_constraint": "区分値。元ファイル内の設定値を使用。確認値例: #N/A、0、その他、任期更新（期間変更）、任期満了による退職、新規、新規（METI勤務歴あり）、本務異動（身柄含む）",
          "source_required": "任意",
          "max_length": 200
        },
        {
          "display_name": "日額単価",
          "logical_name": "crb3c_dailyrate",
          "kind": "integer",
          "source_constraint": "0以上。円単位。小数不可",
          "source_required": "任意",
          "min": 0,
          "max": 1000000000
        },
        {
          "display_name": "勤務時間開始",
          "logical_name": "crb3c_workstart",
          "kind": "text",
          "source_constraint": "時刻。H:MM又はHH:MM形式（24時間制）",
          "source_required": "任意",
          "max_length": 200
        },
        {
          "display_name": "勤務時間終了",
          "logical_name": "crb3c_workend",
          "kind": "text",
          "source_constraint": "時刻。H:MM又はHH:MM形式（24時間制）",
          "source_required": "任意",
          "max_length": 200
        },
        {
          "display_name": "１日あたりの勤務時間",
          "logical_name": "crb3c_dailyhours",
          "kind": "decimal",
          "source_constraint": "0以上24以下の時間数。小数可",
          "source_required": "任意",
          "min": 0,
          "max": 1000000000,
          "precision": 2
        },
        {
          "display_name": "超勤基礎単価（参考）",
          "logical_name": "crb3c_overtimebaserate",
          "kind": "integer",
          "source_constraint": "0以上。円単位。小数不可",
          "source_required": "任意",
          "min": 0,
          "max": 1000000000
        },
        {
          "display_name": "支出科目名",
          "logical_name": "crb3c_budgetitem",
          "kind": "text",
          "source_constraint": "支出科目名称。文字列",
          "source_required": "任意",
          "max_length": 200
        },
        {
          "display_name": "辞令案",
          "logical_name": "crb3c_appointmentdraft",
          "kind": "text",
          "source_constraint": "改行を含む複数行文字列",
          "source_required": "任意",
          "max_length": 4000
        },
        {
          "display_name": "辞令コメント",
          "logical_name": "crb3c_appointmentcomment",
          "kind": "text",
          "source_constraint": "改行を含む複数行文字列可",
          "source_required": "任意",
          "max_length": 4000
        },
        {
          "display_name": "その他備考",
          "logical_name": "crb3c_notes",
          "kind": "text",
          "source_constraint": "自由記述。改行可",
          "source_required": "任意",
          "max_length": 4000
        }
      ]
    },
