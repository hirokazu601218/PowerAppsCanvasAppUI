      "tool": {
        "driver": {
          "fullName": "PowerApps app checker",
          "name": "PowerApps app checker",
          "rules": [
            {
              "id": "acc-ReadableScreenNameNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Revise screen name"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Give the screen  a title that describes what's on the screen or what it's used for."
                ],
                "level": "Low",
                "primaryCategory": "accessibility",
                "whyFix": "People who are blind, have low vision, or a reading disability rely on screen titles to navigate using the screen reader. "
              }
            },
            {
              "id": "acc-FocusBorderShouldBeVisible",
              "messageStrings": {
                "issue": {
                  "text": "Focus isn't showing"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Change the FocusedBorderThickness property to be more than 0."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app."
              }
            },
            {
              "id": "acc-TabIndexShouldBeDefinedForInteractiveControl",
              "messageStrings": {
                "issue": {
                  "text": "Missing tab stop"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "People who use the keyboard with your app will not be able to access this element without a tab stop."
              }
            },
            {
              "id": "app-UnusedVariables",
              "messageStrings": {
                "issue": {
                  "text": "未使用の変数"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "未使用の変数を削除してください。"
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "この変数は、宣言されていますが、どのコントロールによっても参照されていないため、不要です。"
              }
            },
            {
              "id": "app-CollectingReadOnlyTable",
              "messageStrings": {
                "issue": {
                  "text": "コレクションが初期化されていますが決して更新されていません"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Collect または ClearCollect を、App.Formulas の名前付き計算式で置き換えてください。たとえば、MyTable = Filter(source, condition) のようにします。名前付き計算式は入力が変化したときに計算され、コレクションと違って追跡コストを発生させません。"
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "コレクションは更新されることを前提に作られています。Power Apps は、コレクションのデータが変化した場合にそれに依存するアイテムの同期が保たれるよう、個々のコレクションの状態をトラックします。コレクションのデータが設定後に決して変化しない場合、そのトラック処理は無駄なコストになります。追加コストなしで同じデータを得るには、名前付き計算式を使う方法があります。"
              }
            },
            {
              "id": "app-ScreenHasManyControls",
              "messageStrings": {
                "issue": {
                  "text": "画面上のコントロールが多すぎます"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "画面上のコントロールの数を減らします。",
                  "アプリを複数の画面に分割して、画面ごとの複雑さを緩和してください。",
                  "コンポーネントを使用して、複数の画面で同一のグループ化されたコントロールを統合し、重複を減らします。",
                  "繰り返し使用する類似した一連のコントロールを、ギャラリーを使用して表現します。",
                  "アプリを複数のアプリに分割して、各アプリのサイズを小さくし、パフォーマンスが高くなるようにします。"
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "各コントロールはリソースを消費するため、画面のコントロールが多すぎると、アプリが低速になったり応答性が悪くなったりする可能性があります。\"Screen1\" の推定複雑度は 704 です。これは、推奨される最大しきい値 (300) を超えています。"
              }
            },
            {
              "id": "app-CountRowsGalleryAllItems",
              "messageStrings": {
                "issue": {
                  "text": "CountRows と AllItems ではなく AllItemsCount を使ってください"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "パフォーマンスを改善するために、CountRows(Gallery.AllItems) を Gallery.AllItemsCount で置き換えてください。"
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "ギャラリーの AllItems プロパティに対して CountRows を使うと、入力データ ソースのコピーとすべての子コントロールの現在の状態を含んだ出力テーブルが無条件に作成されます。これは、初期化されていない行の初期化を無条件に発生させ、CPU サイクルやメモリを余分に消費することにつながり、行数分のネットワーク要求を発生させる可能性もあります。"
              }
            }
          ],
          "version": "1.349"
        }
      }
    }
  ],
  "version": "2.1.0"
}